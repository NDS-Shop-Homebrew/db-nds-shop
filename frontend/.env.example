# ==============================================================================
# Site Frontend (db-nds-shop) - Variables build-time
# Copie ce fichier en .env dans frontend/
# IMPORTANT: variables build-time, doivent être définies AVANT le build Docker
# ==============================================================================

# Version affichée
VITE_APP_VERSION=1.0.0

# URL publique de l'API du site (même origine en prod → vide ou https://db-nds-shop.fr)
VITE_API_URL=https://db-nds-shop.fr
