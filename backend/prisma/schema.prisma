// Schéma Prisma du site db-nds-shop — MÊME base de données que upload.db-nds-shop.fr.
// Les tables game_request / game_request_vote sont définies côté upload (source de vérité)
// et répliquées ici, comme pour le bot.
//
// ⚠️ Schéma PARTIEL : ne JAMAIS lancer `prisma db push` depuis ce repo.
// Prisma verrait toutes les autres tables (user, session, bot_*, …) comme « en trop »
// et les SUPPRIMERAIT avec leurs données. `db push` uniquement depuis upload.db-nds-shop.fr/backend.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Game {
  id            String            @id
  slug          String            @unique
  title         String
  titleId       String?
  version       String?
  author        String?
  developer     String?
  publisher     String?
  descriptionMd String?           @db.Text
  systems       Json
  genres        Json
  categories    Json
  color         String?
  colorBg       String?
  priority      Boolean           @default(false)
  stars         Int               @default(0)
  iconUrl       String?
  imageUrl      String?
  boxartUrl     String?
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())
  screenshots   GameScreenshot[]
  downloads     GameDownload[]
  scripts       GameScript[]

  @@map("game")
}

model GameScreenshot {
  id          String @id
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  description String
  url         String
  order       Int

  @@map("game_screenshot")
}

model GameDownload {
  id       String @id
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  fileName String
  url      String
  size     BigInt?
  type     String

  @@map("game_download")
}

model GameScript {
  id     String @id
  gameId String @map("gameId")
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name   String
  script Json

  @@map("game_script")
}

model GameRequest {
  id            String            @id @default(cuid())
  title         String
  systems       String?
  note          String?           @db.Text
  requesterId   String?
  requesterName String?
  createdAt     DateTime          @default(now())
  votes         GameRequestVote[]

  @@index([title])
  @@map("game_request")
}

model GameRequestVote {
  requestId String
  request   GameRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())

  @@id([requestId, userId])
  @@map("game_request_vote")
}

model DownloadLog {
  id        String   @id @default(cuid())
  game      String
  title     String?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([game])
  @@index([createdAt])
  @@map("DownloadLog")
}
