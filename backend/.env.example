# ==============================================================================
# db-nds-shop/backend - Variables d'environnement
# Copie ce fichier en .env dans backend/
# ==============================================================================

# Environnement
NODE_ENV=production

# Port du serveur
PORT=3001

# URL publique que sert ce site
SITE_URL="https://db-nds-shop.fr"

# ------------- DATABASE (MySQL) -------------
DATABASE_URL="mysql://ndsshop:CHANGE_ME_mdp@mysql:3306/ndsshop"

# ------------- Storage (chemins DANS le container) -------------
# Base du stockage centralisé
STORAGE_PATH="/srv/nds-shop"
# Assets médios (icons, screenshots, boxarts)
MEDIA_STORAGE_PATH="/srv/nds-shop/assets"
# ROMs
ROMS_PATH="/srv/nds-shop/roms"
# Base de données NDS
NDSDB_PATH="/srv/nds-shop/ndsdb"

# ------------- Discord -------------
DISCORD_BOT_TOKEN="CHANGE_ME_token_du_bot"
DISCORD_GUILD_ID="1271186486070345843"

# ------------- Session (JWT) — générer avec: openssl rand -base64 32 -------------
# IMPORTANT: différent du BETTER_AUTH_SECRET
SESSION_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ------------- Discord OAuth (login site) -------------
DISCORD_OAUTH_CLIENT_ID="CHANGE_ME"
DISCORD_OAUTH_CLIENT_SECRET="CHANGE_ME"
