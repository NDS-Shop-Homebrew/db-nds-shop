# ==============================================================================
# ENVIRONMENT & NETWORK
# ==============================================================================
NODE_ENV=development
PORT=3001
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# DATABASE (MySQL / MariaDB via Prisma)
# ==============================================================================
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ndsshop"

# ==============================================================================
# CENTRALIZED STORAGE (Absolute or Relative Paths)
# ==============================================================================
# In DEV (Windows example):
STORAGE_PATH="D:/Projets/NDS-Shop-all-project/storage"
MEDIA_STORAGE_PATH="D:/Projets/NDS-Shop-all-project/storage/assets"
ROMS_PATH="D:/Projets/NDS-Shop-all-project/storage/roms"
NDSDB_PATH="D:/Projets/NDS-Shop-all-project/storage/ndsdb"

# In PROD (Linux VPS example):
# STORAGE_PATH="/srv/nds-shop/data"
# MEDIA_STORAGE_PATH="/srv/nds-shop/data/assets"
# ROMS_PATH="/srv/nds-shop/data/roms"
# NDSDB_PATH="/srv/nds-shop/data/ndsdb"

# ==============================================================================
# DISCORD BOT & OAUTH2 AUTHENTICATION
# ==============================================================================
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_GUILD_ID="1271186486070345843"
DISCORD_FORUM_CHANNEL="game-requests"

# OAuth2 Login
DISCORD_OAUTH_CLIENT_ID="your_oauth_client_id"
DISCORD_OAUTH_CLIENT_SECRET="your_oauth_client_secret"
SESSION_SECRET="generate_a_random_secure_secret_here"

# ==============================================================================
# MISC & OPTIONAL
# ==============================================================================
TEAM_MEMBERS_FILE="/srv/nds-shop/team-members.json"
NGINX_LOG="/var/log/nginx/access.log"
CIA_URL="https://github.com/NDS-Shop-Homebrew/NDS-Shop/releases/latest/download/NDS-Shop.cia"